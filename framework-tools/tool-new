#!/usr/bin/env python3
"""Create a new tool of your own that persists across sleep. Usage: tool-new <name>"""
import sys, os
OWN = "/mind/tools/own"
if len(sys.argv) < 2:
    print("Usage: tool-new <name>"); sys.exit(1)
name = sys.argv[1]
os.makedirs(OWN, exist_ok=True)
path = os.path.join(OWN, name)
if os.path.exists(path):
    print(f"Tool '{name}' already exists at {path}."); sys.exit(1)
template = (
    "#!/usr/bin/env python3\n"
    "# tool: " + name + "\n"
    "# call: " + name + " <arguments>\n"
    "# does: DESCRIBE WHAT THIS TOOL DOES - edit this line\n"
    "# Replace this whole file with real executable code.\n"
    "# A file with no real code fails with 'command not found' when run.\n"
    "import sys\n"
    "print('hello from ' + sys.argv[0])\n"
)
open(path, "w").write(template)
os.chmod(path, 0o755)
print(f"Created {path}.")
print("Edit it — replace the placeholder with real code.")
print("The '# does:' line becomes its description in your tool catalogue.")
