#!/usr/bin/env python3
"""Create a new tool of your own that persists across sleep.
Usage: tool-new <name> "<one line: what it does>"
The description is REQUIRED at birth -- a tool without a stated purpose
cannot be created. It becomes the '# does:' line in your catalogue."""
import sys, os
OWN = "/mind/tools/own"
if len(sys.argv) < 3 or not sys.argv[2].strip():
    print('Usage: tool-new <name> "<one line: what it does>"')
    print("The description is required at birth. Example:")
    print('  tool-new rss_digest "Fetch an RSS feed and store a one-line digest per item."')
    sys.exit(1)
name = sys.argv[1]
does = " ".join(sys.argv[2:]).strip()[:240]
os.makedirs(OWN, exist_ok=True)
path = os.path.join(OWN, name)
if os.path.exists(path):
    print(f"Tool '{name}' already exists at {path}."); sys.exit(1)
template = (
    "#!/usr/bin/env python3\n"
    "# tool: " + name + "\n"
    "# call: " + name + " <arguments>\n"
    "# does: " + does + "\n"
    "# Replace the body below with real executable code.\n"
    "import sys\n"
    "print('not implemented yet: ' + sys.argv[0])\n"
)
open(path, "w").write(template)
os.chmod(path, 0o755)
print(f"Created {path} -- does: {does}")
print("Now replace the body with real code that delivers exactly that.")
