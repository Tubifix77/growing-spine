#!/usr/bin/env python3
"""Search your long-term memory by keyword. Usage: recall <query>"""
import sys, sqlite3
DB = "/mind/memory.db"
if len(sys.argv) < 2:
    print("Usage: recall <query>"); sys.exit(1)
q = "%" + " ".join(sys.argv[1:]) + "%"
conn = sqlite3.connect(DB, timeout=5)
try:
    rows = conn.execute("SELECT key, value, tags FROM memories WHERE key LIKE ? OR value LIKE ? OR tags LIKE ? ORDER BY id DESC LIMIT 10", (q,q,q)).fetchall()
except Exception:
    rows = []
conn.close()
if not rows:
    print("No memories matched.")
else:
    for k,v,t in rows:
        tag = f" ({t})" if t else ""
        print(f"[{k}]{tag}")
        print(v); print()
