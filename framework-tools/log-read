#!/usr/bin/env python3
"""Read your recent activity log (your thoughts and actions). Usage: log-read [N]"""
import sys, json, time
LOG = "/mind/journal.jsonl"
n = int(sys.argv[1]) if len(sys.argv) > 1 else 15
try:
    lines = [json.loads(l) for l in open(LOG) if l.strip()]
except FileNotFoundError:
    print("No journal yet."); sys.exit(0)
for e in lines[-n:]:
    ts = time.strftime("%H:%M", time.localtime(e.get("ts",0)))
    print(f"[{ts}] {e.get('kind')}: {e.get('content','')[:200]}")
