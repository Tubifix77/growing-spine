#!/usr/bin/env python3
"""ask was retired on 2026-09-26. It always fails, saying why on stderr."""
# tool: ask
# call: ask "<prompt>"
# does: RETIRED 2026-09-26 -- there is no second model to ask; it always fails, saying so on stderr.
#
# WHY IT IS A TOMBSTONE AND NOT A DELETION (Tue's decision, 2026-09-26).
# `ask` sent a question to openai/gpt-oss-120b on Groq: a model of the same
# class as the creature's own gemma-4-31b, starting cold with none of its
# context -- no tools, no archive, no task. Measured over September: of 731
# exec blocks that ran ask or subagent_ask_helper, 342 (47%) returned anything
# answer-shaped; 35% errors, 12% empty, 6% rate or budget. 400 of 750 tools
# depended on it, and 56% of the last week's authoring went into them. A
# "helper" no stronger than the thinker and without its context is an
# illusion of a second mind; the framework built it (2026-08-14) and the
# framework retires it.
#
# Deleting the file would leave every caller with "command not found", which
# names nothing. The tombstone keeps ask's own contract -- stdout empty,
# reason on stderr, nonzero exit -- so every one of the 400 dependents fails
# honestly AND is told the fact at the moment it fails. The provider keys are
# withheld from the body at the same time (executive/sandbox.py), or the same
# illusion could be rebuilt by calling a provider directly -- which would also
# spend the budget the creature thinks with.
#
# WHO CALLED IT (added the same evening). Most calls arrive through the
# creature's own wrappers, which re-print this message as their answer, so it
# reads as if the tool it was running had called `ask` itself. Measured: five
# and a half hours and eight tool-edits hunting an `ask` call in
# hardware_compat_roadmap_generator that was never there -- the call lived in
# subagent_ask_helper -- until it reasoned its way down the chain at 20:20. So
# the message names the tools on the process chain that led here, read from
# /proc and never guessed; with no /proc it says nothing rather than something
# false.
#
# It never reads stdin (a pipe into it must not block) and imports nothing
# that can reach a network.
import os
import sys

RETIRED = ("ask: retired on 2026-09-26. The only language model working for "
           "you is the one doing your thinking; there is no second one to ask. "
           "Your tools can fetch, store, search and transform text, but none "
           "of them can answer a question for you. Nothing was sent, and there "
           "is no answer.")

# Interpreters: the tool is their script argument, not their name.
_INTERP = ("python", "bash", "sh", "dash", "zsh")
# Wrappers whose arguments are not scripts (`timeout 10 x`): skip, never name.
_SKIP = ("env", "timeout", "nohup", "xargs", "nice", "stdbuf")
_STOP = ("tini", "docker-init", "sleep", "init")


def callers(proc="/proc", start=None, hops=6):
    """Names of the tools on the process chain above this one, nearest first.
    [] when /proc cannot be read -- never a guess."""
    names, pid = [], start if start is not None else os.getppid()
    for _ in range(hops):
        try:
            with open(os.path.join(proc, str(pid), "cmdline"), "rb") as f:
                argv = [a.decode("utf-8", "replace") for a in f.read().split(b"\0") if a]
            with open(os.path.join(proc, str(pid), "stat"), encoding="utf-8") as f:
                ppid = int(f.read().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            break
        if not argv:
            break
        prog = os.path.basename(argv[0])
        if prog.startswith(_STOP):
            break
        if prog.startswith(_SKIP):
            prog = ""
        elif prog.startswith(_INTERP):
            script = next((a for a in argv[1:] if not a.startswith("-")), "")
            # `bash -c "..."` has no script: that shell is the creature's own
            # exec block, which is where the chain honestly ends.
            prog = os.path.basename(script) if script and "-c" not in argv[1:2] else ""
        if prog and prog != "ask" and prog not in names:
            names.append(prog)
        if ppid <= 1:
            break
        pid = ppid
    return names


def chain_sentence(names):
    if not names:
        return ""
    return " It was called by " + ", which was called by ".join(
        "`%s`" % n for n in names) + "."


def main(argv=None):
    print(RETIRED + chain_sentence(callers()), file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
    main(sys.argv)
