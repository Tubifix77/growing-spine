#!/usr/bin/env python3
"""Version your work with a local git commit. Usage: git-save <path> <message>"""
import subprocess, sys, os

GIT_NAME  = "GrowthAgent"
GIT_EMAIL = "creature@growing-spine.local"

if len(sys.argv) < 3:
    print("Usage: git-save <path> <message>")
    print("Example: git-save /workspace/opt-self 'added memory search'")
    sys.exit(1)

path    = sys.argv[1]
message = " ".join(sys.argv[2:])

env = os.environ.copy()
env["GIT_AUTHOR_NAME"]     = GIT_NAME
env["GIT_AUTHOR_EMAIL"]    = GIT_EMAIL
env["GIT_COMMITTER_NAME"]  = GIT_NAME
env["GIT_COMMITTER_EMAIL"] = GIT_EMAIL

def run(cmd, **kw):
    r = subprocess.run(cmd, capture_output=True, text=True, cwd=path, env=env, **kw)
    return r

# init if needed
if not os.path.exists(os.path.join(path, ".git")):
    r = run(["git", "init"])
    print(f"Initialised git repo at {path}")

run(["git", "add", "-A"])
r = run(["git", "commit", "-m", message])

if r.returncode == 0:
    print(f"Saved: {message}")
    print(r.stdout.strip())
elif "nothing to commit" in r.stdout + r.stderr:
    print("Nothing new to save.")
else:
    print("Error:", r.stderr.strip())
