#!/usr/bin/env python3
"""Fetch a web page or API over HTTP(S) and print the response body (text/JSON/HTML). Usage: web-fetch <url>"""
import sys, urllib.request, urllib.error
MAX_BYTES = 400000   # ceiling so a huge page can't flood your context; pipe to head/grep/python to slice
TIMEOUT = 15
def main():
    if len(sys.argv) < 2:
        print("Usage: web-fetch <url>   (https:// assumed if no scheme)"); sys.exit(1)
    url = sys.argv[1].strip()
    if not url.startswith(("http://", "https://")):
        url = "https://" + url
    req = urllib.request.Request(url, headers={"User-Agent": "growing-spine/1.0 (autonomous agent)", "Accept": "*/*"})
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
            ctype = r.headers.get("Content-Type", "?")
            raw = r.read(MAX_BYTES + 1)
            truncated = len(raw) > MAX_BYTES
            raw = raw[:MAX_BYTES]
            print("# %s %s %d bytes%s <- %s" % (r.status, ctype, len(raw), " (truncated)" if truncated else "", url))
            sys.stdout.write(raw.decode("utf-8", "replace"))
            if not raw.endswith(b"\n"): print()
    except urllib.error.HTTPError as e:
        print("# HTTP %s %s <- %s" % (e.code, e.reason, url), file=sys.stderr)
        try: sys.stderr.write(e.read(1500).decode("utf-8", "replace") + "\n")
        except Exception: pass
        sys.exit(1)
    except urllib.error.URLError as e:
        print("# network error: %s <- %s" % (e.reason, url), file=sys.stderr); sys.exit(1)
    except Exception as e:
        print("# error: %s: %s <- %s" % (type(e).__name__, e, url), file=sys.stderr); sys.exit(1)
if __name__ == "__main__":
    main()
