#!/usr/bin/env python3
"""List everything you remember, newest first. Usage: memories"""
import sqlite3
DB = "/mind/memory.db"
conn = sqlite3.connect(DB, timeout=5)
try:
    rows = conn.execute("SELECT key, substr(value,1,80) FROM memories ORDER BY id DESC").fetchall()
except Exception:
    rows = []
conn.close()
if not rows:
    print("No memories yet. Save one with: remember <key> <value>")
else:
    print(f"{len(rows)} memories:")
    for k,v in rows:
        print(f"  {k}: {v}")
