#!/usr/bin/env python3
"""Search your tools by MEANING, not name. Usage: tool-find "what you need" [how_many] -- lists your most relevant existing tools and what each does. Example: tool-find "turn rss dates into a timeline" """
import json, os, sys, time, uuid

STATE = "/mind/state"
OWN = "/mind/tools/own"


def does_line(name):
    try:
        with open(os.path.join(OWN, name), errors="ignore") as f:
            for ln in f.read().splitlines()[:8]:
                if "does:" in ln.lower():
                    return ln.split(":", 1)[1].strip()[:100]
    except OSError:
        pass
    return ""


def main():
    if len(sys.argv) < 2 or not sys.argv[1].strip():
        print('Usage: tool-find "what you need" [how_many]')
        sys.exit(1)
    q = sys.argv[1].strip()
    k = int(sys.argv[2]) if len(sys.argv) > 2 and sys.argv[2].isdigit() else 6
    rid = uuid.uuid4().hex[:12]
    tmp = os.path.join(STATE, "toolfind_req.tmp")
    with open(tmp, "w") as f:
        json.dump({"id": rid, "q": q, "k": k}, f)
    os.replace(tmp, os.path.join(STATE, "toolfind_req.json"))
    res_path = os.path.join(STATE, "toolfind_res_%s.json" % rid)
    deadline = time.time() + 6
    while time.time() < deadline:
        if os.path.exists(res_path):
            try:
                with open(res_path) as f:
                    res = json.load(f)
            except Exception:
                time.sleep(0.1)
                continue
            try:
                os.remove(res_path)
            except OSError:
                pass
            if not res.get("ok"):
                print("# tool-find unavailable right now (%s). Fallback: tools | grep <word>"
                      % res.get("error", "?"))
                sys.exit(1)
            hits = res.get("results", [])
            if not hits:
                print("# nothing similar found. Try different words, or: tools | grep <word>")
                sys.exit(0)
            print('# your tools most relevant to: "%s"' % q)
            for name, _score in hits:
                d = does_line(name)
                print("  %-38s %s" % (name, d or "(no description line)"))
            sys.exit(0)
        time.sleep(0.2)
    print("# tool-find timed out (the librarian may be asleep). Fallback: tools | grep <word>")
    sys.exit(1)


main()
