#!/usr/bin/env python3
# tool: DomainModelBuilder
# call: DomainModelBuilder <domain>
# does: Builds a structured domain model (entities and relationships) by chaining archive search, gap filling, and LLM synthesis.

import subprocess
import sys
import json
import re

def run_tool(cmd):
    try:
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True, check=True)
        return result.stdout.strip()
    except subprocess.CalledProcessError as e:
        return f"ERROR: {e.stderr.strip()}"

def main():
    if len(sys.argv) < 2:
        print("Usage: DomainModelBuilder <domain>")
        sys.exit(1)

    domain = sys.argv[1]
    print(f"--- Building Domain Model for: {domain} ---")

    # Step 1: Identify Core Entities
    print(f"Step 1: Identifying core entities for {domain}...")
    entity_prompt = f"List the 7 most important core entities, concepts, or roles in the domain of {domain}. Provide them as a simple comma-separated list, no numbering."
    entities_raw = run_tool(f"subagent_ask_helper \"{entity_prompt}\"")
    
    if "ERROR" in entities_raw or not entities_raw:
        print(f"Failed to identify entities: {entities_raw}")
        sys.exit(1)

    entities = [e.strip() for e in entities_raw.split(",")]
    print(f"Identified Entities: {', '.join(entities)}")

    # Step 2: Gather Definitions via Archive Search and Gap Filling
    domain_data = {}
    for entity in entities:
        print(f"Processing entity: {entity}...")
        
        # Search archive first
        search_res = run_tool(f"keyword-archive-search \"{entity}\"")
        
        # Use knowledge_gap_filler to ensure we have a good definition
        # We'll ask the gap filler specifically for a definition in the context of the domain
        gap_prompt = f"What is {entity} in the context of {domain}? Provide a concise 1-2 sentence definition."
        definition = run_tool(f"knowledge_gap_filler \"{gap_prompt}\"")
        
        if "ERROR" in definition:
            definition = "Definition unavailable."
        
        domain_data[entity] = {
            "definition": definition,
            "archive_notes": search_res if "ERROR" not in search_res else ""
        }

    # Step 3: Map Relationships
    print(f"Step 3: Mapping relationships between entities...")
    entities_list_str = ", ".join(entities)
    rel_prompt = f"Given these entities in the domain of {domain}: [{entities_list_str}], describe the primary relationships between them. Format as a concise list of 'Entity A -> Relationship -> Entity B' statements."
    relationships = run_tool(f"subagent_ask_helper \"{rel_prompt}\"")
    
    if "ERROR" in relationships:
        relationships = "Relationships could not be mapped."

    # Step 4: Final Synthesis and Archiving
    print(f"Step 4: Synthesizing and storing domain model...")
    model_output = {
        "domain": domain,
        "entities": domain_data,
        "relationships": relationships
    }
    
    model_json = json.dumps(model_output, indent=2)
    
    # Store in keyword archive
    archive_key = f"domain-model-{domain.lower().replace(' ', '-')}"
    run_tool(f"keyword-archive-store \"{archive_key}\" \"{model_json}\" --tags domain-model")
    
    print(f"\nDomain Model for {domain} successfully built and stored under keyword: {archive_key}")
    print("\n--- Final Domain Model Summary ---")
    print(f"Entities: {len(entities)}")
    print(f"Relationships:\n{relationships}")

if __name__ == "__main__":
    main()
