#!/usr/bin/env python3
import subprocess
import json
import argparse
import sys
import os

# tool: liveeventactionscheduler
# call: liveeventactionscheduler [--url <url>]
# does: Fetches new events, triages them for actionability via LLM, and schedules persistent plans for high-priority items.

def run_cmd(cmd):
    try:
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True, check=True)
        return result.stdout.strip()
    except subprocess.CalledProcessError as e:
        print(f"Error running command {cmd}: {e.stderr}")
        return None

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--url", help="Optional specific URL to process instead of fetching new events")
    args = parser.parse_args()

    items = []
    if args.url:
        items = [{"title": "Specified URL", "url": args.url}]
    else:
        print("Fetching new events...")
        raw_events = run_cmd("wake_catchup_fetcher.real")
        if not raw_events:
            print("No new events found.")
            return
        try:
            items = json.loads(raw_events)
        except json.JSONDecodeError:
            print("Failed to decode events JSON.")
            return

    if not items:
        print("No events to process.")
        return

    print(f"Processing {len(items)} events...")

    for item in items:
        title = item.get("title", "Unknown Title")
        url = item.get("url", "")
        
        print(f"\nTriaging: {title}")
        
        # Triage step: Is this actionable?
        triage_query = f"Event: {title}\nURL: {url}\nIs this event highly actionable or high-priority for an autonomous AI agent to research or act upon? Answer 'YES' or 'NO' and provide a one-sentence reason."
        triage_result = run_cmd(f"subagent_ask_helper \"{triage_query}\"")
        
        if not triage_result:
            continue
            
        print(f"Triage Result: {triage_result}")
        
        if "YES" in triage_result.upper():
            print("Event is actionable. Generating plan...")
            
            # Generate a plan for the event
            plan_query = f"Create a detailed action plan to investigate and respond to this event: {title} ({url})"
            plan_id = run_cmd(f"plan_from_question \"{plan_query}\"")
            
            if plan_id:
                print(f"Plan created and scheduled: {plan_id}")
                # Archive the triage and scheduling event
                archive_note = f"Scheduled plan {plan_id} for event: {title}. Reason: {triage_result}"
                run_cmd(f"keyword-archive-store 'event-scheduler' \"{archive_note}\"")
            else:
                print("Failed to create plan.")
        else:
            print("Event skipped (not high-priority).")

if __name__ == "__main__":
    main()
