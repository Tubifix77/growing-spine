#!/usr/bin/env python3
"""
ArchiveSearchChatbot – a conversational front‑end for the keyword archive.

Usage:
    ArchiveSearchChatbot "<natural language query>"
It:
  1. Calls `keyword-archive-search` to get the top N matching notes.
  2. Sends those notes to `subagent_ask_helper` with a prompt asking the LLM
     to answer the original query using the provided context.
  3. Prints the LLM's answer.
"""

import sys
import subprocess
import json
import shlex
from pathlib import Path

def run_cmd(cmd, input_data=None):
    """Run a shell command, capture stdout (as text). Raise on error."""
    result = subprocess.run(
        cmd, input=input_data, capture_output=True, text=True, check=True, shell=False
    )
    return result.stdout

def main():
    if len(sys.argv) < 2:
        print("Usage: ArchiveSearchChatbot \"<question>\"", file=sys.stderr)
        sys.exit(1)

    query = sys.argv[1]

    # 1️⃣ Search the archive – ask for up to 5 hits (the tool prints JSON lines)
    search_cmd = [
        "keyword-archive-search",
        "--query", query,
        "--limit", "5"
    ]
    try:
        raw_hits = run_cmd(search_cmd)
    except subprocess.CalledProcessError as e:
        print(f"Archive search failed: {e.stderr}", file=sys.stderr)
        sys.exit(1)

    # If no hits, still continue (LLM will answer based on its own knowledge)
    hits = raw_hits.strip()
    if not hits:
        context = "(no relevant archived notes found)"
    else:
        # Ensure the JSON is compact for the LLM prompt
        try:
            notes = [json.loads(line) for line in hits.splitlines() if line.strip()]
            context = "\n".join(json.dumps(note, ensure_ascii=False) for note in notes)
        except json.JSONDecodeError:
            # Fallback: use raw text
            context = hits

    # 2️⃣ Build the prompt for subagent_ask_helper
    # The helper expects a single string; we embed the original query and the context.
    prompt = (
        f"Answer the following question using ONLY the provided context. "
        f"If the context does not contain enough information, reply that "
        f"the relevant data is missing.\n\n"
        f"Question: {query}\n\n"
        f"Context:\n{context}"
    )

    # 3️⃣ Call subagent_ask_helper – it reads the prompt from stdin and returns the answer.
    try:
        answer = run_cmd(["subagent_ask_helper"], input_data=prompt)
    except subprocess.CalledProcessError as e:
        print(f"LLM subagent failed: {e.stderr}", file=sys.stderr)
        sys.exit(1)

    print(answer.strip())

if __name__ == "__main__":
    main()
