#!/usr/bin/env bash
# does: Obtain today's wake_orient_digest, refine it via subagent_ask_helper, and archive the result with keyword-archive-store.
set -euo pipefail

# -------------------------------------------------------------------------
# 1. Fetch the raw wake orient digest (one‑off, cached for the day)
# -------------------------------------------------------------------------
# The wake_orient_digest tool writes the digest to stdout; capture it.
RAW_DIGEST="$(wake_orient_digest)" || {
    echo "Error: could not obtain wake_orient_digest" >&2
    exit 1
}

# -------------------------------------------------------------------------
# 2. Refine the digest via subagent_ask_helper
# -------------------------------------------------------------------------
# We ask the sub‑agent to produce a concise, keyword‑rich synopsis.
REFINED_DIGEST="$(subagent_ask_helper "Please summarise the following daily digest, extract the top 5 keywords, and format as a short paragraph:" "$RAW_DIGEST")" || {
    echo "Error: subagent_ask_helper failed" >&2
    exit 1
}

# -------------------------------------------------------------------------
# 3. Archive the refined digest
# -------------------------------------------------------------------------
# Store under the keyword "daily-wake-digest" with a tag for the current date.
TODAY="$(date +%Y-%m-%d)"
ARCHIVE_ID="$(keyword-archive-store "daily-wake-digest" "$REFINED_DIGEST" --tags "$TODAY")" || {
    echo "Error: failed to store digest in keyword‑archive" >&2
    exit 1
}

# -------------------------------------------------------------------------
# 4. Output result
# -------------------------------------------------------------------------
echo "Archived refined wake digest as ID $ARCHIVE_ID"
