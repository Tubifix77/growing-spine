#!/usr/bin/env python3
# tool: plan_from_question_composed
# call: plan_from_question_composed <goal>
# does: Compose subagent_ask_helper with step-planner-tracker to turn a goal into a persistent plan.

import sys
import subprocess
import shlex

def run_command(cmd):
    try:
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True, check=True)
        return result.stdout.strip()
    except subprocess.CalledProcessError as e:
        print(f"Error running command: {cmd}\nStdout: {e.stdout}\nStderr: {e.stderr}", file=sys.stderr)
        return None

def main():
    if len(sys.argv) < 2:
        print("Usage: plan_from_question_composed <goal>")
        sys.exit(1)

    goal = " ".join(sys.argv[1:])
    
    # 1. Use subagent_ask_helper to generate steps
    prompt = (
        f"Break the following goal into a sequence of concrete, actionable, and ordered steps. "
        f"Output ONLY the steps, one per line, without numbers, bullet points, or introductory text. "
        f"Goal: {goal}"
    )
    
    # We use shlex.quote to ensure the prompt is passed safely to the shell
    steps_text = run_command(f"subagent_ask_helper {shlex.quote(prompt)}")
    
    if not steps_text:
        print("Failed to generate steps from subagent.")
        sys.exit(1)

    # 2. Clean and parse steps
    steps = [s.strip() for s in steps_text.splitlines() if s.strip()]
    if not steps:
        print("No valid steps were generated.")
        sys.exit(1)

    # 3. Use step-planner-tracker to add the plan
    # Syntax: step-planner-tracker add "Goal" "Step 1" "Step 2" ...
    step_args = " ".join([shlex.quote(s) for s in steps])
    cmd_add = f"step-planner-tracker add {shlex.quote(goal)} {step_args}"
    
    result = run_command(cmd_add)
    
    if result:
        print(f"Successfully created plan for: {goal}")
        print(f"Result: {result}")
        print("\nSteps added:")
        for i, s in enumerate(steps, 1):
            print(f"{i}. {s}")
    else:
        print("Failed to persist the plan in step-planner-tracker.")
        sys.exit(1)

if __name__ == "__main__":
    main()
