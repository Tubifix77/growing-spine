#!/usr/bin/env python3
"""
ResearchPlanExecutor
does: Orchestrates plan_from_question → knowledge_gap_filler → step-planner-tracker
       to generate a detailed research agenda, fill identified gaps, and
       enqueue actionable steps. Returns a JSON line with the created plan ID
       and a short summary.
"""

import sys
import json
import subprocess
import shlex
from typing import List

def run_cmd(cmd: List[str]) -> str:
    """Run a command, capture stdout, raise on error."""
    result = subprocess.run(cmd, capture_output=True, text=True, check=True)
    return result.stdout.strip()

def create_plan(question: str) -> str:
    """Create a plan using plan_from_question and return the plan ID."""
    out = run_cmd(["plan_from_question", question])
    # plan_from_question prints the plan ID on its own line
    return out.strip()

def get_plan_steps(plan_id: str) -> List[str]:
    """Retrieve the ordered steps for a plan using step-planner-tracker."""
    out = run_cmd(["step-planner-tracker", "list", plan_id])
    # Expected format: each line "N. <step>"
    steps = []
    for line in out.splitlines():
        if "." in line:
            _, step = line.split(".", 1)
            steps.append(step.strip())
    return steps

def fill_gap(step: str) -> str:
    """Run knowledge_gap_filler on a step and return enriched text."""
    out = run_cmd(["knowledge_gap_filler", step])
    return out.strip()

def update_plan(plan_id: str, enriched_steps: List[str]) -> None:
    """Replace the plan steps with enriched ones via step-planner-tracker."""
    # Build a semicolon‑separated string for the tracker
    steps_str = ";".join(enriched_steps)
    run_cmd(["step-planner-tracker", "add", plan_id, steps_str])

def summarize_plan(plan_id: str) -> str:
    """Create a short summary of the plan using subagent_ask_helper."""
    # Ask the LLM to summarise the plan ID's steps
    prompt = f"Summarise the research plan {plan_id} in one sentence."
    out = run_cmd(["subagent_ask_helper", prompt])
    return out.strip()

def main():
    if len(sys.argv) != 2:
        print("Usage: ResearchPlanExecutor <research_question>", file=sys.stderr)
        sys.exit(1)

    question = sys.argv[1]

    # 1. Create initial plan
    plan_id = create_plan(question)

    # 2. Retrieve steps
    steps = get_plan_steps(plan_id)

    # 3. Fill knowledge gaps for each step
    enriched = [fill_gap(s) for s in steps]

    # 4. Update the plan with enriched steps
    update_plan(plan_id, enriched)

    # 5. Summarise the final plan
    summary = summarize_plan(plan_id)

    # Output result as JSON for easy downstream consumption
    result = {"plan_id": plan_id, "summary": summary}
    print(json.dumps(result))

if __name__ == "__main__":
    main()
