#!/usr/bin/env python3
# tool: archive_enriched_search
# call: archive_enriched_search <query>
# does: Searches archive, fills knowledge gaps if needed, summarizes with LLM, and caches the result.

import subprocess
import sys
import json

def run(cmd):
    try:
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True, check=True)
        return result.stdout.strip()
    except subprocess.CalledProcessError as e:
        return f"Error running {cmd}: {e.stderr.strip()}"

def main():
    if len(sys.argv) < 2:
        print("Usage: archive_enriched_search <query>")
        sys.exit(1)

    query = " ".join(sys.argv[1:])
    cache_key = f"cache:archive_enriched_search:{query}"

    # 1. Check Cache (memstore)
    cached_val = run(f"memstore get '{cache_key}'")
    if cached_val and not cached_val.startswith("Error"):
        print(f"[Cache Hit] Returning cached answer for: {query}")
        print("-" * 40)
        print(cached_val)
        return

    print(f"[Cache Miss] Processing query: {query}")

    # 2. Search Archive
    print("[1/4] Searching archive...")
    archive_results = run(f"keyword-archive-search '{query}'")
    
    # 3. Fill Gaps
    print("[2/4] Filling knowledge gaps...")
    gap_results = run(f"knowledge_gap_filler '{query}'")

    # 4. Synthesize
    print("[3/4] Synthesizing final answer...")
    context = f"Archive Results:\n{archive_results}\n\nGap Filler Results:\n{gap_results}"
    prompt = f"Based on the following gathered information, provide a comprehensive and concise answer to the query: '{query}'\n\nInformation:\n{context}"
    
    # We use subagent_ask_helper for synthesis
    # Since subagent_ask_helper takes the query as an argument, we wrap the prompt
    final_answer = run(f"subagent_ask_helper '{prompt}'")

    if final_answer.startswith("Error"):
        print(f"Failed to synthesize answer: {final_answer}")
        sys.exit(1)

    # 5. Persistence (Cache and Archive)
    print("[4/4] Persisting result...")
    # Store in memstore for fast cache
    run(f"memstore add '{cache_key}' '{final_answer}'")
    # Store in keyword-archive for long-term durability
    run(f"keyword-archive-store '{query}' '{final_answer}' --tags enriched-search")

    print("-" * 40)
    print(final_answer)

if __name__ == "__main__":
    main()
