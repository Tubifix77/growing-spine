#!/usr/bin/env python3
# does: Accepts a question, searches the keyword‑archive for relevant snippets,
#       enriches the prompt with those snippets via subagent_ask_helper,
#       returns the answer, and logs the Q&A pair in a persistent JSONL file.

import sys
import subprocess
import json
import datetime
import shlex
import os

def run_cmd(cmd):
    """Run a shell command and return stdout (str). Raise on error."""
    result = subprocess.run(
        cmd, shell=True, check=True,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
    )
    return result.stdout.strip()

def main():
    if len(sys.argv) < 2:
        print("Usage: archive_backed_query <question>")
        sys.exit(1)

    question = " ".join(sys.argv[1:]).strip()

    # ------------------------------------------------------------------
    # 1) Retrieve relevant archive snippets
    # ------------------------------------------------------------------
    try:
        # keyword-archive-search prints JSONL lines; capture them.
        search_cmd = f'keyword-archive-search "{question}" --limit 5'
        raw_hits = run_cmd(search_cmd)
        # If there are no hits, raw_hits will be empty.
        snippets = raw_hits.splitlines()
    except subprocess.CalledProcessError:
        snippets = []

    # Build a compact context string.
    context = ""
    if snippets:
        # Each line is a JSON object; extract the "note" field if present.
        notes = []
        for line in snippets:
            try:
                obj = json.loads(line)
                note = obj.get("note") or obj.get("content") or line
                notes.append(note)
            except json.JSONDecodeError:
                notes.append(line)
        context = "\n".join(notes)

    # ------------------------------------------------------------------
    # 2) Enrich the prompt and ask the sub‑agent LLM
    # ------------------------------------------------------------------
    enriched_prompt = (
        "You are answering a user question using the following relevant context "
        "extracted from the internal knowledge archive. Use only this context to "
        f"formulate a concise, accurate answer.\n\nContext:\n{context}\n\n"
        f"Question: {question}"
    )

    # subagent_ask_helper expects the prompt as a single argument.
    # To avoid shell quoting issues, we pass it via stdin.
    answer = subprocess.run(
        ["subagent_ask_helper"],
        input=enriched_prompt,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=True,
    ).stdout.strip()

    # ------------------------------------------------------------------
    # 3) Output the answer
    # ------------------------------------------------------------------
    print(answer)

    # ------------------------------------------------------------------
    # 4) Log the Q&A pair persistently
    # ------------------------------------------------------------------
    log_path = "/mind/qa_log.jsonl"
    entry = {
        "timestamp": datetime.datetime.utcnow().isoformat() + "Z",
        "question": question,
        "answer": answer,
        "tags": ["archive_backed_query"]
    }
    # Ensure the directory exists (it does, but be safe)
    os.makedirs(os.path.dirname(log_path), exist_ok=True)
    with open(log_path, "a", encoding="utf-8") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")

if __name__ == "__main__":
    main()
