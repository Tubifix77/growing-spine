#!/usr/bin/env python3
"""
Tool: semantic_search_recall
does: Search the keyword‑archive for a query, rerank results with LLM relevance scoring via subagent_ask_helper,
      store the top N results in memstore for fast recall, and output their memstore IDs.
Usage: semantic_search_recall "<query>" [--limit N]

Arguments:
  <query>        The search string.
  --limit N      Number of top results to keep (default: 3).
"""

import sys
import json
import subprocess
from pathlib import Path

MEMSTORE_CMD = "memstore"
ARCHIVE_SEARCH_CMD = "keyword-archive-search"
SUBAGENT_HELPER_CMD = "subagent_ask_helper"

def run_cmd(cmd, *args):
    """Run a command and return (returncode, stdout, stderr)."""
    result = subprocess.run([cmd] + list(args), capture_output=True, text=True)
    return result.returncode, result.stdout.strip(), result.stderr.strip()

def parse_args(argv):
    if not argv:
        print("Usage: semantic_search_recall \"<query>\" [--limit N]")
        sys.exit(1)
    query = argv[0]
    limit = 3
    if len(argv) >= 3 and argv[1] == "--limit":
        try:
            limit = int(argv[2])
        except ValueError:
            pass
    return query, limit

def search_archive(query, limit):
    """Call keyword-archive-search and return a list of JSON notes."""
    rc, out, err = run_cmd(ARCHIVE_SEARCH_CMD, query, f"--top={limit*3}")  # fetch extra for reranking
    if rc != 0:
        print(f"Archive search failed: {err}", file=sys.stderr)
        sys.exit(1)
    # Each line is a JSON object
    notes = []
    for line in out.splitlines():
        try:
            notes.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return notes

def llm_score(query, note):
    """Ask subagent_ask_helper to score relevance. Expects a short numeric score string."""
    prompt = (
        f"Given the user query: \"{query}\" and the following document snippet, "
        f"rate how relevant the snippet is to the query on a scale of 0 (not relevant) "
        f"to 10 (highly relevant). Respond with only the numeric score.\n\n"
        f"Snippet: {json.dumps(note, ensure_ascii=False)}"
    )
    rc, out, err = run_cmd(SUBAGENT_HELPER_CMD, prompt)
    if rc != 0:
        # If LLM call fails, give a neutral score
        return 5.0
    try:
        return float(out.strip())
    except ValueError:
        return 5.0

def store_in_memstore(key, value):
    """Store a JSON value in memstore and return the generated entry ID."""
    rc, out, err = run_cmd(MEMSTORE_CMD, "add", key, json.dumps(value, ensure_ascii=False))
    if rc != 0:
        print(f"memstore store failed: {err}", file=sys.stderr)
        sys.exit(1)
    # memstore prints the entry ID on success
    return out.strip()

def main():
    query, limit = parse_args(sys.argv[1:])
    # Step 1: retrieve candidate notes
    candidates = search_archive(query, limit)
    if not candidates:
        print("No candidates found.", file=sys.stderr)
        sys.exit(0)

    # Step 2: score each candidate with LLM
    scored = []
    for note in candidates:
        score = llm_score(query, note)
        scored.append((score, note))
    # Step 3: sort descending by score and keep top N
    scored.sort(key=lambda x: x[0], reverse=True)
    top_notes = [note for _, note in scored[:limit]]

    # Step 4: store each top note in memstore
    stored_ids = []
    for idx, note in enumerate(top_notes, start=1):
        mem_key = f"semantic_search_recall:{query}:{idx}"
        entry_id = store_in_memstore(mem_key, note)
        stored_ids.append(entry_id)

    # Output the memstore IDs for verification
    print("\n".join(stored_ids))

if __name__ == "__main__":
    main()
