#!/usr/bin/env python3
# tool: task_backlog_catcher
# call: task_backlog_catcher [rss_url]
# does: Pull missed items from an RSS feed (or Hacker News via wake_catchup_fetcher.real),
#       create a one‑step task for each new item, and index it in memstore.
import sys
import json
import subprocess
import os
import time

def run_cmd(cmd):
    """Run a shell command and return its stdout (text)."""
    result = subprocess.run(cmd, shell=True, capture_output=True, text=True, check=True)
    return result.stdout.strip()

def load_seen():
    """Load the set of URLs we have already turned into tasks."""
    try:
        data = json.loads(run_cmd('memstore get task_backlog_seen'))
        return set(data)
    except Exception:
        return set()

def save_seen(seen):
    """Persist the set of seen URLs."""
    run_cmd(f'memstore set task_backlog_seen \'{json.dumps(list(seen))}\'')
    
def index_task(record):
    """Append a record to the task_backlog index."""
    # Retrieve current list
    try:
        cur = json.loads(run_cmd('memstore get task_backlog'))
    except Exception:
        cur = []
    cur.append(record)
    run_cmd(f'memstore set task_backlog \'{json.dumps(cur)}\'')

def fetch_items(source):
    """Return a list of dicts with keys: title, url, tags."""
    if source:
        # Assume an RSS feed URL
        # 1. download the XML
        xml_path = run_cmd(f'fetch_rss_feed {source}')
        # 2. extract titles & URLs (extract_rss_titles prints only titles;
        #    we also need URLs – the helper tool `extract_rss_titles` only gives titles.
        #    We'll fallback to simple parsing with grep/sed for <link>.
        #    For the purpose of this tool we only need a unique URL; we can reuse the title as URL.
        titles = run_cmd(f'cat {xml_path} | extract_rss_titles')
        items = []
        for t in titles.splitlines():
            items.append({"title": t, "url": f"{source}#{t}", "tags": []})
        return items
    else:
        # Default: Hacker News fetcher (already returns JSON)
        out = run_cmd('wake_catchup_fetcher.real')
        return json.loads(out)

def main():
    source = sys.argv[1] if len(sys.argv) > 1 else ''
    items = fetch_items(source)
    seen = load_seen()
    for it in items:
        url = it.get('url')
        if not url or url in seen:
            continue
        title = it.get('title', 'Untitled')
        # Create a one‑step task: goal = title, step = title
        add_cmd = f'step-planner-tracker add \"{title}\" \"{title}\"'
        plan_id = run_cmd(add_cmd).split()[-1]  # last token is the plan id
        # Record in memstore
        record = {
            "title": title,
            "url": url,
            "plan_id": plan_id,
            "timestamp": int(time.time())
        }
        index_task(record)
        seen.add(url)
    save_seen(seen)
    print(f"Processed {len(items)} items, new tasks added: {len(seen)}")

if __name__ == "__main__":
    main()
