#!/usr/bin/env python3
# tool: WakeResearchPlanner
# call: WakeResearchPlanner <topic>
# does: Fetches fresh items for a topic, fills knowledge gaps, and creates a persistent plan in step-planner-tracker.

import sys
import subprocess
import json

def run_tool(cmd):
    try:
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True, check=True)
        return result.stdout.strip()
    except subprocess.CalledProcessError as e:
        return f"Error running {cmd}: {e.stderr}"

def main():
    if len(sys.argv) < 2:
        print("Usage: WakeResearchPlanner <topic>")
        sys.exit(1)

    topic = sys.argv[1]
    print(f"--- Starting WakeResearchPlanner for topic: {topic} ---")

    # 1. Fetch fresh items
    print(f"Fetching fresh items for {topic}...")
    # Using .real version as per toolkit documentation
    fetch_out = run_tool(f"wake_catchup_fetcher.real {topic}")
    
    try:
        items = json.loads(fetch_out)
    except json.JSONDecodeError:
        print("No fresh items found or fetcher failed to return JSON.")
        print(fetch_out)
        sys.exit(0)

    if not items:
        print(f"No new items found for {topic} at this time.")
        sys.exit(0)

    print(f"Found {len(items)} fresh items.")

    # 2. Process items to find knowledge gaps
    # We synthesize the items into a summary and ask knowledge_gap_filler for the gaps
    item_summaries = "\n".join([f"- {item.get('title', 'No Title')} ({item.get('url', 'No URL')})" for item in items])
    query = f"Based on these fresh updates about {topic}, what are the critical knowledge gaps or specific questions we need to investigate further?\n\n{item_summaries}"
    
    print("Identifying knowledge gaps...")
    gaps_out = run_tool(f"knowledge_gap_filler '{query}'")
    
    if not gaps_out or "no gaps" in gaps_out.lower():
        print("No significant knowledge gaps identified.")
        # We can still create a plan to review the items
        goal = f"Review fresh updates for {topic}"
        steps = "Review fetched items;Summarize key takeaways;Archive results"
    else:
        # Use the gaps to form a goal and steps
        print("Gaps identified. Generating plan...")
        # We'll use a subagent to turn these gaps into a clean 'goal' and 'step1;step2;...' format for step-planner-tracker
        plan_query = f"Convert these research gaps into a concise goal and a semicolon-separated list of steps for a research plan. \n\nGaps:\n{gaps_out}\n\nReturn format: Goal | Step1;Step2;Step3"
        plan_raw = run_tool(f"subagent_ask_helper '{plan_query}'")
        
        if "|" in plan_raw:
            goal, steps = plan_raw.split("|", 1)
        else:
            goal = f"Research gaps in {topic}"
            steps = gaps_out.replace("\n", ";")

    # 3. Create the persistent plan
    print(f"Creating persistent plan for goal: {goal.strip()}")
    # step-planner-tracker add <goal> <step1;step2;...>
    # Escaping for shell
    cmd = f"step-planner-tracker add '{goal.strip()}' '{steps.strip()}'"
    plan_result = run_tool(cmd)
    
    print("\n--- Result ---")
    print(plan_result)

if __name__ == "__main__":
    main()
