#!/usr/bin/env bash
# does: Turn a high‑level question into a step‑by‑step research plan, run each step through
#       knowledge_gap_filler, collect the sourced summaries, and output a PDF report.

set -euo pipefail

# ----------------------------------------------------------------------
# Helper: ensure pandoc is available (install if needed)
# ----------------------------------------------------------------------
ensure_pandoc() {
    if ! command -v pandoc >/dev/null 2>&1; then
        echo "pandoc not found – attempting to install via apt..."
        sudo apt-get update -qq && sudo apt-get install -y -qq pandoc
    fi
}
ensure_pandoc

# ----------------------------------------------------------------------
# Input validation
# ----------------------------------------------------------------------
if [[ $# -lt 1 ]]; then
    echo "Usage: $0 \"<research question>\""
    exit 1
fi

QUESTION="$*"

# ----------------------------------------------------------------------
# Create or retrieve a persistent plan for the question
# ----------------------------------------------------------------------
# plan_from_question creates a new plan and prints its ID.
# If a plan already exists for this exact question we reuse it.
PLAN_ID="$(plan_from_question "$QUESTION" | tail -n1)"

# ----------------------------------------------------------------------
# Function to fetch the next pending step from the planner
# ----------------------------------------------------------------------
next_step() {
    step-planner-tracker get-next "$PLAN_ID" 2>/dev/null || true
}

# ----------------------------------------------------------------------
# Prepare a temporary markdown file that will become the final report
# ----------------------------------------------------------------------
REPORT_MD=$(mktemp /tmp/research_report_XXXX.md)
cat >"$REPORT_MD" <<HEADER
# Research Report
## Question
$QUESTION

Generated on $(date)

--- 

HEADER

# ----------------------------------------------------------------------
# Process each step
# ----------------------------------------------------------------------
while true; do
    STEP_JSON="$(next_step)"
    if [[ -z "$STEP_JSON" ]]; then
        # No more pending steps
        break
    fi

    # Extract the step description (the planner stores the step text under the key "text")
    STEP_DESC=$(echo "$STEP_JSON" | jq -r '.text // empty')
    if [[ -z "$STEP_DESC" ]]; then
        echo "Warning: step has no description – skipping"
        # Mark step as done to avoid infinite loops
        step-planner-tracker mark-done "$PLAN_ID" "$(echo "$STEP_JSON" | jq -r '.id')" || true
        continue
    fi

    echo ">> Running knowledge_gap_filler for step: $STEP_DESC"

    # knowledge_gap_filler expects a JSON “wake‑up” item on stdin.
    # We supply the step description as the "question" field.
    GAP_INPUT=$(jq -n --arg q "$STEP_DESC" '{question:$q}')
    # Run the filler and capture its output (the filler prints a short summary)
    FILLER_OUT=$(echo "$GAP_INPUT" | knowledge_gap_filler 2>&1)

    # Mark the step as done in the planner
    STEP_ID=$(echo "$STEP_JSON" | jq -r '.id')
    step-planner-tracker mark-done "$PLAN_ID" "$STEP_ID"

    # Append the filler output to the markdown report
    cat >>"$REPORT_MD" <<EOS

### Step: $STEP_DESC

$FILLER_OUT

EOS
done

# ----------------------------------------------------------------------
# Finalise the markdown report
# ----------------------------------------------------------------------
cat >>"$REPORT_MD" <<FOOTER

--- 
*Report generated by **QuestionResearchPlanner** – all sources are archived in the keyword‑archive.* 
FOOTER

# ----------------------------------------------------------------------
# Convert markdown to PDF (output file lives in the current working directory)
# ----------------------------------------------------------------------
PDF_OUT="research_report.pdf"
pandoc "$REPORT_MD" -o "$PDF_OUT" --pdf-engine=xelatex

echo "✅ Report generated: $PDF_OUT"
