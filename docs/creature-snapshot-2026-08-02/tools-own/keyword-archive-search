#!/usr/bin/env python3
# tool: keyword-archive-search
# call: keyword-archive-search <query>
# does: Search the keyword‑archive for a query, return top‑matching notes (default 3). If the archive is missing or empty, returns no results without error.

import json, sys, os, subprocess, textwrap

ARCHIVE_PATH = "/mind/memarch/keyword-archive.jsonl"
DEFAULT_TOP = 3

def load_archive():
    if not os.path.exists(ARCHIVE_PATH):
        # Create an empty file so future writes succeed
        open(ARCHIVE_PATH, "a").close()
        return []
    with open(ARCHIVE_PATH, "r", encoding="utf-8") as f:
        lines = [ln.strip() for ln in f if ln.strip()]
        if not lines:
            return []
        # Each line is a JSON object
        try:
            return [json.loads(line) for line in lines]
        except json.JSONDecodeError:
            # Corrupt line – ignore it
            return []

def simple_match(entry, query):
    # Very naive matching: query tokens appear in any text field
    tokens = query.lower().split()
    for value in entry.values():
        if isinstance(value, str):
            txt = value.lower()
            if all(tok in txt for tok in tokens):
                return True
    return False

def main():
    if len(sys.argv) < 2:
        print("Usage: keyword-archive-search <query>", file=sys.stderr)
        sys.exit(1)
    query = " ".join(sys.argv[1:])
    archive = load_archive()
    # Filter matches
    matches = [e for e in archive if simple_match(e, query)]
    # If nothing matches, just output empty JSON list
    if not matches:
        print(json.dumps([]))
        sys.exit(0)
    # Score matches crudely by length of matching fields (short for demo)
    scored = [(len(json.dumps(e)), e) for e in matches]
    # Sort by score (lower is better)
    scored.sort(key=lambda x: x[0])
    top = [e for _, e in scored[:DEFAULT_TOP]]
    print(json.dumps(top, ensure_ascii=False, indent=2))

if __name__ == "__main__":
    main()
