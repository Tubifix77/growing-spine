#!/usr/bin/env bash
# does: Turn a natural‑language goal into a persisted, tracked plan in a single call.
# Usage: plan_from_question_onecall "<goal>"
set -euo pipefail

goal="$1"

# 1️⃣ Generate a step list using the sub‑agent helper.
# The subagent returns a semi‑colon separated list of steps.
steps_raw=$(subagent_ask_helper "Break the goal into clear, ordered steps. Return them as a single line separated by semicolons." "$goal")
# Example return: "research trail options;pack gear;choose date;notify friends"

# Guard against empty output
if [[ -z "$steps_raw" ]]; then
  echo "Error: subagent returned no steps" >&2
  exit 1
fi

# 2️⃣ Add the plan to the persistent step planner.
plan_id=$(step-planner-tracker add "$goal" "$steps_raw")
# The tracker prints the new plan ID; capture it.
if [[ -z "$plan_id" ]]; then
  echo "Error: step‑planner‑tracker failed to create a plan" >&2
  exit 1
fi

# 3️⃣ Return the plan ID (and optionally the steps for visibility)
echo "PlanID: $plan_id"
echo "Goal: $goal"
echo "Steps:"
IFS=';' read -ra steps <<< "$steps_raw"
for i in "${!steps[@]}"; do
  printf "  %d. %s\n" $((i+1)) "${steps[i]}"
done
