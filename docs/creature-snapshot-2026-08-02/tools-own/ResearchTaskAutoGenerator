#!/usr/bin/env bash
# does: From a high‑level research question, generate a detailed plan via `plan_from_question`,
#       run `knowledge_gap_filler` on each sub‑question, and record the enriched steps
#       back into the same plan using `step-planner-tracker`. Returns the plan ID.

# ----------------------------------------------------------------------
# Helper: extract the list of sub‑questions stored for a plan.
# `step-planner-tracker list <plan-id>` prints the steps in JSON; we pull the
# "description" field of each step (these are the sub‑questions generated by
# plan_from_question).
extract_subquestions() {
    local plan_id=$1
    step-planner-tracker get "$plan_id" |
        jq -r '.steps[]?.description' |
        grep -v '^$' || true
}
# ----------------------------------------------------------------------

# ----------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------
if [[ -t 0 && -z "$1" ]]; then
    echo "Usage: $0 \"<high‑level research question>\""
    exit 1
fi

# Accept the question via argument or stdin
if [[ -n "$1" ]]; then
    QUESTION="$*"
else
    QUESTION="$(cat -)"
fi

# 1️⃣ Create a base plan from the high‑level question
# The planner prints a JSON line containing the new plan id.
PLAN_JSON=$(plan_from_question "$QUESTION")
PLAN_ID=$(echo "$PLAN_JSON" | jq -r '.plan_id')
if [[ -z "$PLAN_ID" || "$PLAN_ID" == "null" ]]; then
    echo "Failed to create plan (plan_from_question output): $PLAN_JSON" >&2
    exit 1
fi

# 2️⃣ Pull the sub‑questions that `plan_from_question` generated
SUBQUESTIONS=$(extract_subquestions "$PLAN_ID")
if [[ -z "$SUBQUESTIONS" ]]; then
    echo "No sub‑questions found for plan $PLAN_ID" >&2
    exit 1
fi

# 3️⃣ For each sub‑question, run knowledge_gap_filler and record the outcome
#    as a new step in the same plan.
while IFS= read -r subq; do
    # Run knowledge_gap_filler – it expects JSON on stdin.
    # We'll wrap the sub‑question as a minimal JSON payload.
    filler_input=$(jq -n --arg q "$subq" '{question: $q}')
    filler_output=$(echo "$filler_input" | knowledge_gap_filler)

    # Record the filler result as a step (description = subq, note = filler_output)
    step-planner-tracker add "$PLAN_ID" \
        --description "$subq (gap‑filled)" \
        --note "$filler_output"
done <<< "$SUBQUESTIONS"

# 4️⃣ Summarise the final plan
echo "Research plan created: $PLAN_ID"
echo "Original question: $QUESTION"
echo "Sub‑questions (gap‑filled) added as steps."
