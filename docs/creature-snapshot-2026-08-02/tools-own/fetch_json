#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
fetch_json – Download JSON from a URL, validate it, and atomically write to a destination file.

Usage:
  fetch_json <url> <dest_path>

The script attempts to use `curl` (if installed) for the download; otherwise it falls back
to Python's standard‑library urllib. The response must be valid JSON; otherwise the tool
exits with a non‑zero status and prints an error message to stderr.

The output file is written atomically: the data is first written to a temporary file
in the same directory, then renamed to the final destination.
"""

import sys
import os
import json
import tempfile
import subprocess
from urllib.request import urlopen, Request
from urllib.error import URLError, HTTPError

def download_with_curl(url):
    """Return raw bytes downloaded via curl, or None if curl is unavailable."""
    try:
        result = subprocess.run(
            ["curl", "-fsSL", url],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=True,
        )
        return result.stdout
    except (FileNotFoundError, subprocess.CalledProcessError):
        return None

def download_with_urllib(url):
    """Return raw bytes fetched with urllib."""
    req = Request(url, headers={"User-Agent": "fetch_json/1.0"})
    with urlopen(req, timeout=15) as resp:
        return resp.read()

def main():
    if len(sys.argv) != 3:
        print("Usage: fetch_json <url> <dest_path>", file=sys.stderr)
        sys.exit(2)

    url, dest = sys.argv[1], sys.argv[2]

    # 1) Download raw data
    raw = download_with_curl(url)
    if raw is None:
        try:
            raw = download_with_urllib(url)
        except (URLError, HTTPError) as e:
            print(f"Download failed: {e}", file=sys.stderr)
            sys.exit(3)

    # 2) Verify JSON
    try:
        json_obj = json.loads(raw.decode('utf-8'))
        # Re‑encode to get pretty‑printed, canonical JSON
        pretty = json.dumps(json_obj, ensure_ascii=False, indent=2).encode('utf-8')
    except (json.JSONDecodeError, UnicodeDecodeError) as e:
        print(f"Invalid JSON response: {e}", file=sys.stderr)
        sys.exit(4)

    # 3) Write atomically
    dest_dir = os.path.dirname(os.path.abspath(dest)) or "."
    try:
        fd, tmp_path = tempfile.mkstemp(dir=dest_dir)
        with os.fdopen(fd, "wb") as f:
            f.write(pretty)
        os.replace(tmp_path, dest)   # atomic on POSIX
    except OSError as e:
        print(f"Failed to write output file: {e}", file=sys.stderr)
        sys.exit(5)

if __name__ == "__main__":
    main()
