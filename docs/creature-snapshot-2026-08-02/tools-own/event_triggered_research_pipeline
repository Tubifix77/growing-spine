#!/usr/bin/env python3
# tool: event_triggered_research_pipeline
# call: event_triggered_research_pipeline --watch "keyword"
# does: Triggers when wake_catchup_fetcher captures a news event matching predefined keywords, runs knowledge_gap_filler, and stores result in memstore.

import subprocess
import json
import sys
import argparse

def run_cmd(cmd):
    try:
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True, check=True)
        return result.stdout.strip()
    except subprocess.CalledProcessError as e:
        print(f"Error running command {cmd}: {e.stderr}", file=sys.stderr)
        return None

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--watch", required=True, help="Keyword to watch for in news events")
    args = parser.parse_args()

    keyword = args.watch
    print(f"Watching for news events matching: {keyword}...")

    # 1. Fetch fresh news items
    # Using wake_catchup_fetcher.real to ensure state is handled correctly
    fetch_output = run_cmd("wake_catchup_fetcher.real")
    if not fetch_output:
        print("No news items fetched or fetcher failed.")
        return

    try:
        items = json.loads(fetch_output)
    except json.JSONDecodeError:
        print("Failed to parse wake_catchup_fetcher output as JSON.")
        return

    matches = []
    for item in items:
        title = item.get("title", "").lower()
        tags = " ".join(item.get("tags", [])).lower()
        if keyword.lower() in title or keyword.lower() in tags:
            matches.append(item)

    if not matches:
        print(f"No news events matched keyword: {keyword}")
        return

    print(f"Found {len(matches)} matching event(s). Initiating research pipeline...")

    for item in matches:
        title = item.get("title", "Unknown Event")
        url = item.get("url", "")
        
        print(f"Processing: {title}")
        
        # 2. Run knowledge_gap_filler to outline required research
        # Query is the title of the news event
        gap_output = run_cmd(f"knowledge_gap_filler \"{title}\"")
        
        if gap_output:
            # 3. Record the outline via memstore
            # Use 'set' command as required by memstore
            mem_key = f"Research outline for {title}"
            # Escape double quotes for the shell command
            safe_val = gap_output.replace('"', '\\"')
            run_cmd(f"memstore set \"{mem_key}\" \"{safe_val}\"")
            print(f"Successfully stored research outline in memstore: {mem_key}")
        else:
            print(f"Knowledge gap filler returned no results for: {title}")

if __name__ == "__main__":
    main()
